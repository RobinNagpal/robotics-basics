# pixi
.pixi/

# colcon
build/
install/
log/

# model files a doc's example code writes where it is run
*.pt

# python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# editors / IDEs
.idea/
*.iml
.vscode/

# macOS
.DS_Store

# camera_basics: downloaded model weights, drawn training pictures, training
# runs and annotated output. All of it is remade by the scripts.
src/camera/camera_basics/models/
src/camera/camera_basics/datasets/
src/camera/camera_basics/runs/
src/camera/camera_basics/out/
.env
.envrc
# Terraform: the provider cache and any local state. The lock file is NOT
# ignored — it pins provider versions and belongs in the repository. Real state
# lives in S3, but a stray local copy would contain the deployer's secret key.
deployment/terraform/.terraform/
*.tfstate
*.tfstate.*
*.tfplan

# Narration: the recordings are large and can be remade from the transcripts,
# so they live in S3 rather than here. The transcripts and the manifest are
# committed, because the transcript is the part worth reviewing and the
# manifest is what tells the site which pages have a player.
narration/audio/

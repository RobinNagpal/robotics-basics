# The worker's own AWS keys, limited to the feedback bucket. In extension/terraform:
#   terraform output -raw worker_access_key_id
#   terraform output -raw worker_secret_access_key
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
FEEDBACK_BUCKET=robotics-basics-feedback-<account-id>

# Every 2 minutes while testing. Every 30 minutes is '*/30 * * * *'.
SCHEDULE=*/2 * * * *

# The clone Claude works in, made on the first run if it is missing.
REPO_DIR=/Users/<you>/feedback-worker/robotics-basics
REPO_URL=git@github.com:RobinNagpal/robotics-basics.git

# The full path, because PM2 may start the worker without your shell's PATH.
CLAUDE_BIN=/Users/<you>/.local/bin/claude
CLAUDE_MODEL=
# One Claude turn may take this long before it is stopped.
TIMEOUT_MINUTES=60
# A run due while another is still working waits this long, then is skipped.
WAIT_MINUTES=60

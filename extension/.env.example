# Extension (read at build time). The function URL from `terraform output -raw feedback_api_url`,
# without a trailing slash, or http://localhost:8787 for the local server.
WXT_API_URL=https://xxxxxxxx.lambda-url.us-east-1.on.aws

# Local server only (npm run server). It uses your own AWS credentials.
FEEDBACK_BUCKET=robotics-basics-feedback-<account-id>
API_KEYS_PARAM=/robotics-basics/feedback-api-keys
AWS_REGION=us-east-1
PORT=8787
